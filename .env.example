# Local Postgres from docker-compose
DATABASE_URL=postgres://bodh:bodh@localhost:5433/bodh

# Dev sign-in: while GOOGLE_CLIENT_ID is empty, every request runs as this user
# and "Preview as" can switch roles. Production refuses to start in this mode.
DEV_USER_EMAIL=kshitij@rechargestudio.com

# Google sign-in. Leave the client empty for dev mode.
# Redirect URIs to register on the OAuth client:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/connect/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random characters, e.g. `openssl rand -base64 36`
AUTH_SECRET=
APP_URL=http://localhost:3000
# Workspace domains allowed to sign in, comma separated
ALLOWED_EMAIL_DOMAINS=rechargestudio.com

# Shows a "Sample data" badge while the database holds seed data
DEMO_DATA=true

# Secrets backend: "local" writes to .secrets/ (gitignored); "gcp" uses Secret Manager
SECRETS_BACKEND=local
GCP_PROJECT_ID=

# Uploads: "local" writes to .uploads/ (gitignored); "gcs" uses the GCS_BUCKET bucket
STORAGE_BACKEND=local
GCS_BUCKET=

# Search Console property to sync, e.g. sc-domain:asttrolok.com. Empty picks one.
SEARCH_CONSOLE_SITE=

# Worker
WORKER_PORT=8787
# Shared token the scheduler sends to the worker as X-Worker-Token
WORKER_TOKEN=change-me-dev-token
