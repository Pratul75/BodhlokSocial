# Local Postgres from docker-compose
DATABASE_URL=postgres://bodh:bodh@localhost:5433/bodh

# Dev sign-in: until Google sign-in is configured, every request runs as this user.
DEV_USER_EMAIL=kshitij@rechargestudio.com
# Domain allowed to sign in once Google OAuth is set up
ALLOWED_EMAIL_DOMAIN=rechargestudio.com

# Shows a "Sample data" badge while the database holds seed data
DEMO_DATA=true

# Secrets backend: "local" writes to .secrets/ (gitignored); "gcp" uses Secret Manager
SECRETS_BACKEND=local
GCP_PROJECT_ID=

# Worker
WORKER_PORT=8787
# Shared token Cloud Scheduler / Cloud Tasks send to the worker (OIDC in production)
WORKER_TOKEN=change-me-dev-token
