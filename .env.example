# Every variable the web app, worker and scripts read. Copy to .env for local development.
# Lines that are commented out are optional; the value shown is the default.

# ---------- Database ----------
# Local Postgres from docker-compose
DATABASE_URL=postgres://bodh:bodh@localhost:5433/bodh
# Cloud SQL: the Unix socket directory (the host in DATABASE_URL is then ignored)
# DB_SOCKET_DIR=
# DB_POOL_SIZE=10
# First admin, created by `pnpm db:migrate` only when the database has no admin yet
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=

# ---------- Sign-in ----------
# Dev sign-in: while GOOGLE_CLIENT_ID is empty, every request runs as this user and
# "Preview as" can switch roles. Never in production: NODE_ENV=production always needs Google.
DEV_USER_EMAIL=kshitij@rechargestudio.com

# Google sign-in. Leave the client empty for dev mode.
# Redirect URIs to register on the OAuth client:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/connect/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random characters, e.g. `openssl rand -base64 36`
AUTH_SECRET=
APP_URL=http://localhost:3000
# Workspace domains allowed to sign in, comma separated
ALLOWED_EMAIL_DOMAINS=rechargestudio.com

# ---------- Secrets and files ----------
# Secrets backend: "local" writes to .secrets/ (gitignored); "gcp" uses Secret Manager
SECRETS_BACKEND=local
GCP_PROJECT_ID=
# SECRETS_DIR=.secrets
# Production refuses local secret files unless this is "true" (the VM sets it)
# ALLOW_LOCAL_SECRETS=

# Uploads: "local" writes to .uploads/ (gitignored); "gcs" uses the GCS_BUCKET bucket
STORAGE_BACKEND=local
GCS_BUCKET=
# UPLOADS_DIR=.uploads
# Production refuses local uploads unless this is "true" (the VM sets it)
# ALLOW_LOCAL_STORAGE=

# ---------- Worker ----------
WORKER_PORT=8787
# PORT=            (Cloud Run sets this; it wins over WORKER_PORT)
# WORKER_HOST=0.0.0.0   (the VM uses 127.0.0.1)
# Shared token the scheduler and the web app send as X-Worker-Token. In production it must be
# at least 24 characters and not this example value; generate one with `openssl rand -hex 32`.
WORKER_TOKEN=change-me-dev-token
# Where the web app sends agent runs and SEO jobs. Required in production; without it, local
# development runs them inside the web process.
# WORKER_URL=http://127.0.0.1:8787
# LOG_LEVEL=info   (debug | info | warn | error)

# ---------- Alerts (optional) ----------
# Errors are written as JSON lines; on Cloud Run, Cloud Error Reporting picks them up with no setup.
# Slack-compatible incoming webhook for the daily failed-jobs digest (POST /jobs/ops/alerts)
# ALERT_WEBHOOK_URL=
# Send the digest even on days with nothing to report
# ALERT_ALWAYS=

# ---------- Tracking ----------
# Signing secret for events from the BODH backend, shared with the BODH team.
# Generate with `openssl rand -hex 32`. See docs/bodh-events.md.
BODH_EVENTS_SECRET=

# GA4 BigQuery export: dataset is analytics_<property id>; project defaults to the
# ga4 service account's project. Leave the dataset empty to find it automatically.
GA4_BQ_DATASET=
GA4_BQ_PROJECT=

# Google Ads, once the developer token is approved
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Conversion action IDs per event, e.g. {"registration":"123","activation":"456","paid":"789"}
GOOGLE_ADS_CONVERSION_ACTIONS=
# GOOGLE_ADS_API_VERSION=v21
# META_GRAPH_VERSION=v23.0

# ---------- Lead forms ----------
# Meta Lead Ads webhook: the verify token you type into the Meta app's webhook settings,
# and the app secret Meta signs deliveries with (X-Hub-Signature-256).
# META_LEADS_VERIFY_TOKEN=
# META_APP_SECRET=
# Google Ads lead form webhook: the key you set on the lead form's webhook integration.
# GOOGLE_LEADS_WEBHOOK_KEY=

# ---------- Search and SEO ----------
# Search Console property to sync, e.g. sc-domain:asttrolok.com. Empty picks one.
SEARCH_CONSOLE_SITE=
# Bearer token the website uses to read /api/feed/*. The feed is off without it.
# SEO_FEED_TOKEN=
# Public site address for feeds and page links
# SEO_SITE_URL=https://www.bodhlok.com
# SEO_AUDIT_MAX_PAGES=500

# ---------- AI ----------
# The Anthropic key normally goes in Connections; this is a local fallback.
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5
# Team-wide monthly spend on agents, chat and AI-visibility checks, and the cap for one run (USD)
# AI_MONTHLY_BUDGET_USD=150
# AI_RUN_CAP_USD=6
# Extra skills folder for the agents (the VM uploads one)
# SKILLS_DIR=
# AI-visibility engines: keys normally go in Connections; these are local fallbacks.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar
# GEO_GEMINI_MODEL=gemini-3.8-flash
# GEO_CLAUDE_MODEL=claude-opus-5-5

# VM only: the Community, Mentions and Analyst agent timers spend the AI budget, so the installer
# leaves them off unless listed here: community, mentions, analyst (weekly + monthly), or all.
# ENABLE_NEW_AGENT_TIMERS=

# ---------- Creative ----------
# Use the runtime's Google identity (ADC) for Vertex instead of a stored service-account key
# VERTEX_USE_ADC=
# VERTEX_PROJECT_ID=
# VERTEX_IMAGE_MODEL=gemini-3.1-flash-image
# VERTEX_VIDEO_MODEL=veo-3.1-fast-generate-001
# VERTEX_VIDEO_LOCATION=us-central1
# Team-wide generation limits per month
# CREATIVE_MONTHLY_IMAGES=300
# CREATIVE_MONTHLY_VIDEOS=30
# Optional limits for one person, on top of the team's (off unless set)
# CREATIVE_MONTHLY_IMAGES_PER_USER=
# CREATIVE_MONTHLY_VIDEOS_PER_USER=
# Postiz create-post calls allowed per hour (Postiz allows 30)
# POSTIZ_HOURLY_BUDGET=25

# ---------- Sample data ----------
# `pnpm db:seed` wipes users, connections and content. It runs only with SEED_CONFIRM=yes,
# and with NODE_ENV=production also needs SEED_ALLOW_PRODUCTION=yes.
# SEED_CONFIRM=
