{
  "name": "bodh-growth-os",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "check:schedules": "node scripts/check-schedules.mjs",
    "test": "turbo run test",
    "db:up": "docker compose up -d db",
    "db:push": "pnpm --filter @bodh/db push",
    "db:seed": "pnpm --filter @bodh/worker seed",
    "start": "turbo run start",
    "db:migrate": "pnpm --filter @bodh/db migrate",
    "db:generate": "pnpm --filter @bodh/db generate"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.2",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
